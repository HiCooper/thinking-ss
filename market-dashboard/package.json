{
  "name": "market-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A股大盘看板 — 两市成交额 / 中美10年期国债收益率 / 融资融券",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:setup": "bash scripts/setup-data-env.sh",
    "data:refresh": "bash scripts/refresh.sh",
    "data:validate": "python3 scripts/validate_data.py",
    "holdings:export": "python3 scripts/export_holdings.py"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
