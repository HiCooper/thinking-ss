{
  "name": "market-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A股大盘看板 — 两市成交额 / 中美10年期国债收益率 / 融资融券",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:refresh": "bash scripts/refresh.sh",
    "data:validate": "python3 scripts/validate_data.py"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
